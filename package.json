  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "verify:fase54": "tsx scripts/verify-architecture-fase54.ts",
    "verify:fase57": "tsx scripts/verify-db-fase57.ts",
    "verify:fase58": "tsx scripts/verify-auth-fase58.ts",
    "verify:fase59": "tsx scripts/verify-provider-fase59.ts",
    "migrate:fase60": "tsx scripts/migrate-fase60.ts",
