# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: The port where the application server runs (default: 3000)
PORT="3000"

# HOST: Network interface bind address (use 127.0.0.1 when running behind a reverse proxy like Nginx)
HOST="0.0.0.0"

# NODE_ENV: Application environment (development | production)
NODE_ENV="development"

# CORS_ORIGIN: Allowed origin for production requests (e.g. https://cms.example.com)
CORS_ORIGIN="http://localhost:3000"

# DATABASE: PostgreSQL Persistence Configuration (Fase 57)
DATABASE_URL="postgresql://user:password@localhost:5432/cms_igrejas?sslmode=disable"
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_USER="postgres"
DATABASE_PASSWORD=""
DATABASE_NAME="cms_igrejas"
DATABASE_SSL="false"
DATABASE_POOL_MIN="2"
DATABASE_POOL_MAX="10"

# AUTH: Authentication and Session Security (Fase 58)
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET=""
