# ==============================================================================
# CONFIGURAÇÃO DE MODELO (TEMPLATE) — NGINX REVERSE PROXY & STATIC ASSETS
# CMS Visual para Igrejas — Fase 63: Preparação da Infraestrutura de Produção
#
# ATENÇÃO: ARQUIVO-MODELO / EXEMPLO PARA FUTURA EXECUÇÃO AUTORIZADA NA VPS.
# NENHUM SERVIÇO REAL É CONFIGURADO OU EXECUTADO NESTA FASE.
# ==============================================================================

# Definição de Upstream para o Backend Node.js / Express (Localhost apenas)
upstream cms_backend_upstream {
    server 127.0.0.1:3001;
    keepalive 32;
}

# Limitação de taxa defensiva por IP (proteção anti-DoS a nível de proxy)
limit_req_zone $binary_remote_addr zone=cms_api_limit:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=cms_auth_limit:10m rate=5r/s;

# ------------------------------------------------------------------------------
# 1. BLOCO HTTP (PORTA 80) — REDIRECIONAMENTO ESTRITO PARA HTTPS
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name cms.example.com; # Substituir pelo domínio oficial homologado

    # Suporte ao desafio ACME do Let's Encrypt / Certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Redirecionamento permanente para HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------------------
# 2. BLOCO HTTPS (PORTA 443) — SERVIÇO PRINCIPAL (FRONTEND + PROXY DA API)
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cms.example.com; # Substituir pelo domínio oficial homologado

    # Certificados SSL / TLS gerenciados via Certbot / Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/cms.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cms.example.com/privkey.pem;

    # Parâmetros modernos de segurança TLS (Mozilla Intermediate Guidelines)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Otimização de Buffer e Compressão Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Diretório raiz com arquivos estáticos compilados do Frontend (Vite)
    root /var/www/cms/current/dist;
    index index.html;

    # Limite de tamanho de requisição coerente com o CMS
    client_max_body_size 10M;

    # Cabeçalhos de Segurança no Reverse Proxy
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Logs de acesso e erro específicos da aplicação
    access_log /var/log/nginx/cms_access.log;
    error_log /var/log/nginx/cms_error.log warn;

    # --------------------------------------------------------------------------
    # ROTA DE ARQUIVOS ESTÁTICOS / ASSETS COM CACHE LONGO
    # --------------------------------------------------------------------------
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg|webp)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public, max-age=15552000, immutable";
        try_files $uri =404;
    }

    # --------------------------------------------------------------------------
    # ROTA DE AUTENTICAÇÃO COM RATE LIMIT ADICIONAL
    # --------------------------------------------------------------------------
    location /api/v1/auth/login {
        limit_req zone=cms_auth_limit burst=5 nodelay;

        proxy_pass http://cms_backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }

    # --------------------------------------------------------------------------
    # ROTA GERAL DA API REST (/api/) PROXIED PARA NODE/EXPRESS
    # --------------------------------------------------------------------------
    location /api/ {
        limit_req zone=cms_api_limit burst=20 nodelay;

        proxy_pass http://cms_backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts de proxy adequados para chamadas síncronas REST
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering on;
    }

    # --------------------------------------------------------------------------
    # ROTA PRINCIPAL DO FRONTEND (SPA FALLBACK PARA /index.html)
    # --------------------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Bloqueio estrito de arquivos sensíveis e ocultos (.env, .git, etc.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
